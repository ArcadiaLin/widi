# Build output and caches
node_modules/
dist/
packages/*/dist/
apps/*/dist/
coverage/
*.tsbuildinfo
*.cpuprofile
*.log
.npm/

# Upstream repositories cloned for reading only. `reference/pi` is the pi
# checkout: pull it freely, check out any tag, it is never built or resolved
# from. See docs/pi-fork.md.
reference/
# Left over from the era when pi was a submodule at this path.
/pi/

# Scratch space. Working notes, drafts, and throwaway analysis go in notes/;
# anything worth keeping is promoted into docs/ or apps/widi/docs/.
notes/
chat_notes/

# Environment
.env

# Editor and OS
.vscode/
.zed/
.idea/
.DS_Store
*.swp
*.swo
*~

# Agent tooling
.claude
.codex
.agents/
.superpowers/
docs/superpowers/
.pi-subagents

# Repo-local runtime config: the checked-in extensions, profiles, themes and
# skills are tracked; everything the runtime writes there is not. Skills are
# tracked one at a time - most of what lands in that directory is personal.
.widi/*
!.widi/extensions/
# The workflow extension is local-only experimental code, not a checked-in demo.
.widi/extensions/workflow/
!.widi/profiles/
!.widi/profiles/**
!.widi/themes/
!.widi/skills/
.widi/skills/*
!.widi/skills/develop-widi-extension/
