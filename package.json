{
	"name": "widi",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/agent",
		"apps/widi"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "npm --workspace @widi/agent-core run build && npm --workspace apps/widi run build",
		"check": "biome check --write --error-on-warnings apps/widi/src apps/widi/tests apps/widi/docs packages/agent/src packages/agent/test && tsgo --noEmit -p tsconfig.json",
		"cli": "npm --workspace apps/widi run cli",
		"tui": "npm --workspace apps/widi run tui",
		"test": "npm run test --workspaces --if-present"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "^22.10.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"shx": "^0.4.0",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"scripts": "^0.1.0"
	}
}
