{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		// The viewer has its own project; DOM types are here only so the test that
		// runs the built page inside a DOM can name the elements it clicks.
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"],
	"exclude": ["node_modules", "dist", "src/viewer/**"]
}
